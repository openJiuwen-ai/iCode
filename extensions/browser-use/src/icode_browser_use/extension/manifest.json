{
  "manifest_version": 3,
  "name": "iCode Browser Bridge",
  "version": "0.3.3",
  "minimum_chrome_version": "125",
  "description": "Lets iCode drive the tab it owns in your real Chrome, with your existing login.",
  "key": "",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "nativeMessaging",
    "alarms",
    "storage",
    "clipboardWrite",
    "webNavigation",
    "declarativeNetRequest"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
