#. English: Model that writes what the buddy says when petted.
#. chrys-meta={"fingerprint":"931f45640e05798485642104d8c820c06b0e793fa6e8fa9bdf98fa2f2466cc65","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/settings/layout.py
msgid "tui.settings.hint.model.role.buddy_model_id"
msgstr "撰写伙伴被抚摸时所说的话的模型。"

#. English: Model that writes session titles.
#. chrys-meta={"fingerprint":"918eebb492a2a447b8bb84b51356f82ef25239e1c92bd6c52582f4375e705bb3","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/settings/layout.py
msgid "tui.settings.hint.model.role.session_title"
msgstr "撰写会话标题的模型。"

#. English: Record traces and logs of what the agent does.
#. chrys-meta={"fingerprint":"bf1d5d0ef8963d08d67603391ccb7bd2521a51196b29605cc9e321d748082882","multiline":false,"placeholders":[]}
