#. English: Language of menus, hints and messages; changes apply immediately.
#. chrys-meta={"fingerprint":"ec66e93eeffb79198acd8c49e3aa25373a97497033d12f0fa6f302864a2d4554","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/settings/layout.py
msgid "tui.settings.hint.ui.locale"
msgstr "菜单、提示和消息使用的语言；更改立即生效。"

#. English: Preview themes with F9.
#. chrys-meta={"fingerprint":"91693c5ea2c35832f9e6e5413eee0c8032ef9aafca815d58e7d558818a9bd169","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/settings/layout.py
msgid "tui.settings.hint.ui.theme"
msgstr "用 F9 预览主题。"

#. English: Tell the agent about files changed outside the conversation at turn
#. boundaries.
#. chrys-meta={"fingerprint":"6fa83c9a6753d2a3d67329552af1abbf5a776a60964f742b239096196c9e4423","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/settings/layout.py
msgid "tui.settings.hint.workspace.change_notice.enabled"
msgstr "在轮次边界告知智能体对话之外被修改的文件。"

#. English: Browse
#. chrys-meta={"fingerprint":"5b8da0b3f4083a121254ee46691d5802ce1c7232b1b26578396fd5c87dee2bdc","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/settings/migrate_dialog.py
msgid "tui.settings.migrate.browse"
msgstr "浏览"

#. English: Cancel
#. chrys-meta={"fingerprint":"ee3eb6e02cd8772be8786b7d714f54bf90abe5d0f0523aebf9c292a1e48c7d3d","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/settings/migrate_dialog.py
msgid "tui.settings.migrate.button.cancel"
msgstr "取消"

#. English: Close
#. chrys-meta={"fingerprint":"b539b71b98c3530fcd17b6257d0bcdd95ec41dbd6ba78a0b8ad40de8ddc5103e","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/settings/migrate_dialog.py
msgid "tui.settings.migrate.button.close"
msgstr "关闭"

#. English: Migrate
#. chrys-meta={"fingerprint":"9082180e0b7879ed870206cd2831f474b7780158e2b2acaeb0ace63468d86f1d","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/settings/migrate_dialog.py
msgid "tui.settings.migrate.button.migrate"
msgstr "迁移"

