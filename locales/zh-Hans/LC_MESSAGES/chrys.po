msgstr "请先关闭主题编辑器，再切换应用主题。"

#. English: Answer the agent's questions inside the conversation instead of a
#. popup.
#. chrys-meta={"fingerprint":"e2ce7079ca96fff496e0f11979e4f4e070872044eb88d8e7a0ee9e69e1d7a460","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/settings/layout.py
msgid "tui.settings.hint.tools.ask_user.inline"
msgstr "把智能体的提问直接显示在对话里，而不是弹出窗口。"

#. English: Blank = default {default} seconds; 0 = no timeout.
#. chrys-meta={"fingerprint":"53b67e72f9d765f41c1bd36d1f01b2d1b4e21dc0d0ac238c89a5947f9e070c14","multiline":false,"placeholders":["default"]}
#: src/chrys/app/tui/screens/settings/layout.py
msgid "tui.settings.hint.tools.ask_user.timeout_seconds"
msgstr "留空 = 默认 {default} 秒；0 = 不超时。"

#. English: Apply Git ignore rules to grep and glob searches. Hidden paths and
#. other ignore rules still apply when off.
#. chrys-meta={"fingerprint":"71a61b74a3e3fd76d7f8bc2782b4475cb49662131e7f2170bdfddc4e663a0e39","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/settings/layout.py
msgid "tui.settings.hint.tools.search.respect_gitignore"
msgstr "grep 和 glob 搜索遵循 Git 忽略规则。关闭后，隐藏路径和其他忽略规则仍然生效。"

#. English: local checks every address before connecting. remote lets the proxy
#. resolve names, as fake-IP proxies need, and leaves blocking private
#. addresses to the proxy. Applies only with a proxy URL.
#. chrys-meta={"fingerprint":"6cc5790e547fa76b21982bdae60254efcb20f470eb839f63f4682134755af45d","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/settings/layout.py
msgid "tui.settings.hint.tools.web_egress.proxy_dns"
