#. English: Allowed once, but the approval could not be remembered. Check
#. storage permissions or manage grants with icode approvals.
#. chrys-meta={"fingerprint":"c91616456df496f2e172de04a6f110be536221689f8ab1922238c4949e6e2d3d","multiline":false,"placeholders":[]}
#: src/chrys/service/agent_middleware/control/approval.py
msgid "approval.reuse.save_failed"
msgstr "本次已允许，但未能记住授权。请检查存储权限，或使用 icode approvals 管理授权。"

#. English: We couldn't attach this image.  {items}
#. English-plural: We couldn't attach these images.  {items}
#. chrys-meta={"fingerprint":"216dc5eacba54d010a0f7c93ce47777fab09b4133cc2254cc187ec69719dbaa7","multiline":true,"placeholders":["items"]}
#: src/chrys/orchestration/engine/run/attachments.py
msgid "attachments.attachment_error"
msgid_plural "attachments.attachment_error#plural"
msgstr[0] ""
"无法附加图像。\n"
"\n"
"{items}"

#. English: The active model profile "{label}" does not support image input.
#. This session already contains image attachments in its active history.
#. Switch to a multimodal profile, or start a new text-only session before
#. continuing.
#. chrys-meta={"fingerprint":"528bd93936feb3a71804d3bf1e030d2481cfd67c882fe64cfcb48f6c126ff079","multiline":true,"placeholders":["label"]}
#: src/chrys/orchestration/engine/run/attachments.py
msgid "attachments.history_vision_unsupported"
msgstr ""
"当前模型配置“{label}”不支持图像输入。\n"
"\n"
"此会话的活动历史记录中已包含图像附件。请切换到多模态配置，或新建一个纯文本会话后再继续。"

#. English: The active model profile does not support image input.  This
#. session already contains image attachments in its active history. Switch to
#. a multimodal profile, or start a new text-only session before continuing.
#. chrys-meta={"fingerprint":"a9b3841a16027e8bdb96e876a05292d5b15d5cd085e67266202c35cc55ee2537","multiline":true,"placeholders":[]}
#: src/chrys/orchestration/engine/run/attachments.py
msgid "attachments.history_vision_unsupported_unnamed"
msgstr ""
"当前模型配置不支持图像输入。\n"
"\n"
"此会话的活动历史记录中已包含图像附件。请切换到多模态配置，或新建一个纯文本会话后再继续。"

#. English: Images cannot be attached to retry or continuation prompts.  Send
#. the image in a new message after this retry or continuation finishes.  Image
#. not attached: {files}
#. English-plural: Images cannot be attached to retry or continuation prompts.
#. Send the image in a new message after this retry or continuation finishes.
#. Images not attached: {files}
#. chrys-meta={"fingerprint":"54b4938c0810954448d1f15a5fbb5840acca7e657faa7d55f15bdd2493f00781","multiline":true,"placeholders":["files"]}
#: src/chrys/orchestration/engine/run/attachments.py
msgid "attachments.retry_image_unsupported"
msgid_plural "attachments.retry_image_unsupported#plural"
msgstr[0] ""
"重试或续接提示中无法附加图像。\n"
"\n"
"请等待此次重试或续接完成后，在新消息中发送图像。\n"
"\n"
"未附加的图像：\n"
"{files}"

#. English: The active model profile "{label}" does not support image input.
#. Enable "Vision Model" in Models, or switch to a multimodal profile and send
#. the message again.  Image not attached: {files}
#. English-plural: The active model profile "{label}" does not support image
#. input.  Enable "Vision Model" in Models, or switch to a multimodal profile
#. and send the message again.  Images not attached: {files}
