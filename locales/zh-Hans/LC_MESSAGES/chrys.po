#. may reach.
#. chrys-meta={"fingerprint":"0298aa1433b326b181ceee725192006c6760a0763d79a732a68a361e979e341e","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/settings/layout.py
msgid "tui.settings.hint.tools.web_search.private_origins"
msgstr "JSON 列表，列出网络搜索可以访问的私有网络或本地网络来源。"

#. English: Expand new tool groups by default. When off, click the tool status
#. at any time to view details.
#. chrys-meta={"fingerprint":"b2b8a4e58431aba828e9a5e19336c9399f3afde680e311e53ecb5c0fd169e47b","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/settings/layout.py
msgid "tui.settings.hint.ui.chat.tool_groups_expanded"
