#. English: Open the agent configuration panel.      Without arguments, opens
#. the main agent settings dialog.     With a target name, opens directly to
#. that settings tab.      Targets:         basic        - Basic agent settings
#. instructions - Edit system instructions         tools        - Configure
#. available tools         sub-agents   - Manage sub-agent configurations
#. skills       - Configure agent skills         mcp          - MCP server
#. settings         memory       - Configure memory files and folders
#. compaction   - Context compaction settings
#. chrys-meta={"fingerprint":"4a7fa755b5290ff4c5230fbd8968207f7597e17696fe46dc615c11c6892e64c3","multiline":true,"placeholders":[]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.agents.body"
msgstr ""
"打开智能体配置面板。\n"
"\n"
"    不带参数时，打开智能体主设置对话框。\n"
"    指定目标名称时，直接打开对应设置标签页。\n"
"\n"
"    目标：\n"
"        basic        - 基本智能体设置\n"
"        instructions - 编辑系统提示词\n"
"        tools        - 配置可用工具\n"
"        sub-agents   - 管理子智能体配置\n"
"        skills       - 配置智能体 Skills\n"
"        mcp          - MCP 服务器设置\n"
"        memory       - 配置记忆文件和文件夹\n"
"        compaction   - 上下文压缩设置"

#. English: none
#. chrys-meta={"fingerprint":"6d8a106e90e658e0f6da3d0ce91881d67e2b9351659c3192b403c517a3eb37da","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.aliases_none"
msgstr "无"

#. English: Control how tool calls are approved during agent execution.
#. Modes:
#. chrys-meta={"fingerprint":"608e18a051e49194d17bdc5463819865e7553bfd23bd151787c554e857b72e46","multiline":true,"placeholders":[]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.approval.body"
msgstr ""
"控制智能体执行期间工具调用的审批方式。\n"
"\n"
"    模式："

#. English: Use tab completion to switch directly to a specific mode.
#. chrys-meta={"fingerprint":"009bcac8ba50ca9eadb16e15fc98755883621a6eab58abab8cc54bbc81be77b6","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.approval.mode_hint"
msgstr "使用 Tab 补全可直接切换到指定模式。"

#. English: Look after the buddy that lives in the sidebar.      Subcommands:
#. hatch   - Hatch your buddy (there is only ever one)         info    - Show
#. how your buddy is doing         pet     - Pet your buddy and hear what it
#. says         mute    - Keep your buddy quiet, or let it speak again
#. name    - Give your buddy a new name
#. chrys-meta={"fingerprint":"cbf50a2d854deff68272ffbbdf15e60b751ca65dbdfa2edd0a7e70274f946bb3","multiline":true,"placeholders":[]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.buddy.body"
msgstr ""
"照顾住在侧栏里的伙伴。\n"
"\n"
"    子命令：\n"
"        hatch   - 孵化你的伙伴（始终只有一个）\n"
"        info    - 查看伙伴的近况\n"
"        pet     - 摸摸伙伴，听听它说什么\n"
"        mute    - 让伙伴保持安静，或让它重新开口\n"
"        name    - 给伙伴起个新名字"

#. English: Change the current working directory for the {app} session.
#. Subsequent file operations and AI context will use the new directory as the
#. base path.
#. chrys-meta={"fingerprint":"cea2115d99bbb987218e571867a7e93f50508783a53cc65d7f98f6e8fdae134f","multiline":true,"placeholders":["app"]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.chdir.body"
msgstr ""
"更改 {app} 会话的当前工作目录。\n"
"\n"
"后续文件操作和 AI 上下文将使用\n"
"新目录作为基准路径。"

#. English: Delete the current {app} session and start a new one.  Unlike /new,
#. which keeps the current session so it can be resumed later, /clear
#. permanently removes it from disk. A confirmation dialog opens first; nothing
#. is deleted until you confirm, and the deletion cannot be undone.
#. chrys-meta={"fingerprint":"2f600952646faf256e695fffdb2280eb6b1c267d31d649d2f03a8483c0a91e29","multiline":true,"placeholders":["app"]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.clear.body"
msgstr ""
"删除当前 {app} 会话并开始一个新会话。\n"
"\n"
"与 /new 不同（/new 会保留当前会话以便之后恢复），\n"
"/clear 会将其从磁盘上永久删除。\n"
"执行前会先弹出确认对话框；在你确认之前不会删除任何内容，\n"
"且删除后无法撤销。"

#. English: Copy conversation turns to the clipboard.  Without arguments,
#. copies the most recent agent turn. With a number N, copies the last N agent
#. turns. "/copy agent N" is equivalent to "/copy N". "/copy user N" copies the
#. last N user turns. Use "all" to copy all turns for a role, or the full
#. transcript.
#. chrys-meta={"fingerprint":"f1cf79e331e1e39de172a9f0f7ec745092d612c9aba69562cdea58f3222ca5bf","multiline":true,"placeholders":[]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.copy.body"
msgstr ""
"将对话轮次复制到剪贴板。\n"
"\n"
"不带参数时，复制最近一个智能体轮次。\n"
"指定数字 N 时，复制最近 N 个智能体轮次。\n"
"\"/copy agent N\" 等同于 \"/copy N\"。\n"
"\"/copy user N\" 复制最近 N 个用户轮次。\n"
"使用 \"all\" 可复制某个角色的全部轮次或完整对话记录。"

#. English: Useful for:     - Sharing conversation snippets     - Archiving
#. important AI outputs     - Creating documentation from AI-generated content
#. chrys-meta={"fingerprint":"98098c1402e2a068831ebcf31615cfd13ac7a7b34e4ff4c7543ff86441547dbd","multiline":true,"placeholders":[]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.copy.useful_for"
msgstr ""
"适用于：\n"
"    - 分享对话片段\n"
"    - 归档重要的 AI 输出\n"
"    - 根据 AI 生成的内容创建文档"

#. English: Display a diff view of all file changes made in the current
#. session.  Shows added, modified, and deleted files with line-by-line
#. changes. Useful for reviewing what the agent has done before committing.
#. chrys-meta={"fingerprint":"521814a3dc5d176ff2410b173e4c175a94c6a6dad2db9915bc058e55d18c6019","multiline":true,"placeholders":[]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.diff.body"
msgstr ""
"显示当前会话中所有文件更改的差异视图。\n"
"\n"
"逐行显示新增、修改和删除的文件。\n"
"适合在提交前检查智能体完成的更改。"

#. English: Show all commands
#. chrys-meta={"fingerprint":"068a8c340542418df7b7da85912b5ecdc181dac6e59c82f7647ff52ffcbbf0c7","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.example.show_all"
msgstr "显示全部命令"

#. English: Show help for /diff
#. chrys-meta={"fingerprint":"5674ba31dea944f68390ef0531e8c7d042b4b468f5b6dde5a8760175a7e3ee4e","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.example.show_diff"
msgstr "显示 /diff 的帮助"

#. English: Show help for /theme
#. chrys-meta={"fingerprint":"f888e4e5654632e5001448a0b50ea0e990fe9137661af8df61768bb2a4e13d88","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.example.show_theme"
msgstr "显示 /theme 的帮助"

#. English: Examples:
#. chrys-meta={"fingerprint":"b4ac8532b4a6bacdaef407385dfcc76733199025d62448192c8a1bdf242d15f5","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.examples_label"
msgstr "示例："

#. English: Exit {app} and return to the terminal.  If an agent is currently
#. running, you will be prompted to confirm before exiting.
#. chrys-meta={"fingerprint":"be388ab0cd1ca19c7e5c5ca1ac391f6fe0f1cef6a0efe91a796a45377166c99e","multiline":true,"placeholders":["app"]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.exit.body"
msgstr ""
"退出 {app} 并返回终端。\n"
"\n"
"如果智能体正在运行，退出前会提示你进行确认。"

#. English: Toggle collapse state on all tool groups in the current
#. conversation view.  Collapsed items show only a summary header. Useful for
#. decluttering the view when reviewing long sessions.
#. chrys-meta={"fingerprint":"37a0fd0ea50a69d919afe758ae14237c1ed6df082defd6b940fb04a4dedd880b","multiline":true,"placeholders":[]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.fold.body"
msgstr ""
"切换当前对话视图中所有工具组的折叠状态。\n"
"\n"
"折叠后只显示摘要标题。\n"
"查看较长会话时可用它精简视图。"

#. English: Create an independent branch of the current session.  The current
#. window stays on the existing session. After the fork is created, choose
#. whether to stay here or switch this window to the forked session.
#. chrys-meta={"fingerprint":"8fa3c6cfea1e5f4ad5e2af6d109848eee72d121c1f9c862581bce84c78ced01a","multiline":true,"placeholders":[]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.fork.body"
msgstr ""
"为当前会话创建一个独立分支。\n"
"\n"
"当前窗口会留在现有会话。分支创建后，可选择\n"
"留在这里，或将此窗口切换到分支会话。"

#. English: ALIASES
#. chrys-meta={"fingerprint":"6c2cade5eb24c3067fd4ec4bf38798be874aa1f57f9b53d97658552c51c951e5","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/main/commands.py
