#. English: Run the hooks defined in <workspace>/.chrys/hooks alongside your
#. global hooks.
#. chrys-meta={"fingerprint":"99df1dbc7a7b0f8d3bf942ea97ded135e0e66c9e0658622f106f76092e31f2d4","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/settings/layout.py
msgid "tui.settings.hint.project.hooks_enabled"
msgstr "运行 <workspace>/.chrys/hooks 中定义的钩子，与全局钩子一起生效。"

