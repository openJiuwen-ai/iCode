#. English: JSON list of custom_http search endpoints profiles may use, each
#. with the credentials it may receive.
#. chrys-meta={"fingerprint":"1da447146c697af5df5a4f4e964010208e8e29e5f87b158084a626f134b26f57","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/settings/layout.py
msgid "tui.settings.hint.tools.web_search.custom_endpoints"
msgstr "JSON 列表，列出智能体配置文件可以使用的 custom_http 搜索端点，以及每个端点可以获取的凭据。"

#. English: JSON list of origins web search may reach over unencrypted HTTP.
#. chrys-meta={"fingerprint":"e84e73b8dc67d05625db12e13ee8ab3a0d65afb12948a4c7d3dbde0837da0f01","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/settings/layout.py
msgid "tui.settings.hint.tools.web_search.http_origins"
msgstr "JSON 列表，列出网络搜索可以通过未加密 HTTP 访问的来源。"

#. English: auto uses the agent profile's search providers, or Exa's public
#. search when it names none. Applies only to agents that include web search.
#. chrys-meta={"fingerprint":"b185279cb289782b291262b2e3758c46bdd62f155c398d1ffa249bad98d1bc22","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/settings/layout.py
