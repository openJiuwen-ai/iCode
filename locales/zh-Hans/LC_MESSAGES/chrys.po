#. English: The device running {app} doesn't seem to have a network connection.
#. Check it first.
#. chrys-meta={"fingerprint":"99bd0dd8413d1ee6ccab7bb891fa6d0865f6468e2ac8bf0c39fe5dbfd6db851d","multiline":false,"placeholders":["app"]}
#: src/chrys/foundation/errors/display.py
msgid "error.hint.maybe_offline"
msgstr "运行 {app} 的设备当前似乎没有网络连接，请先检查网络。"

#. English: The API key is invalid or lacks access. Check the API key in the
#. model profile.
#. chrys-meta={"fingerprint":"aa03cc8798fa7d0fca62908cb79c1976a3f98afdb837e3f7e76413ca92ae8bc7","multiline":false,"placeholders":[]}
#: src/chrys/foundation/errors/display.py
msgid "error.kind.auth_failed"
msgstr "API 密钥无效或没有访问权限。请检查模型配置中的 API 密钥。"

#. English: Connecting to {host} timed out. Check your network and firewall.
#. chrys-meta={"fingerprint":"2095647ac8e4488d51d71298d5de8f48aa5891fcd6f1470bd706bdbbf777c43a","multiline":false,"placeholders":["host"]}
#: src/chrys/foundation/errors/display.py
msgid "error.kind.connect_timeout"
msgstr "连接 {host} 超时。请检查网络连接和防火墙设置。"

#. English: Couldn't connect to {host}. Check your network connection.
#. chrys-meta={"fingerprint":"290865585c57ca21a111fb6971f26c3bc8b3eb095bff4e13e0fe5883318905c9","multiline":false,"placeholders":["host"]}
#: src/chrys/foundation/errors/display.py
msgid "error.kind.connection_failed"
msgstr "无法与 {host} 建立连接。请检查网络连接。"

#. English: The connection to {host} was interrupted.
#. chrys-meta={"fingerprint":"a1ad0e6058c95c4de77a34ab93357b22e75094bc3a89d3925d0795e997f70979","multiline":false,"placeholders":["host"]}
#: src/chrys/foundation/errors/display.py
msgid "error.kind.connection_lost"
msgstr "与 {host} 的连接意外中断。"

#. English: {host} refused the connection. Check the address and port, and that
#. the service is running.
#. chrys-meta={"fingerprint":"c055604093ee68ebae509ada76fe76dbd972b8d7467d08c9588ced1731305855","multiline":false,"placeholders":["host"]}
#: src/chrys/foundation/errors/display.py
msgid "error.kind.connection_refused"
msgstr "{host} 拒绝了连接。请确认服务地址和端口正确，并且服务正在运行。"

#. English: The model service's content filter blocked this request.
#. chrys-meta={"fingerprint":"257eb6ffd8c981f1dec2fd77ebdaabe3d7d8a6fdbb299715e866697e6efb8a91","multiline":false,"placeholders":[]}
#: src/chrys/foundation/errors/display.py
msgid "error.kind.content_filtered"
msgstr "模型服务的内容审核拦截了这次请求。"

#. English: The request exceeds the model's context window. Check that the
#. profile's context window matches the model's real one.
#. chrys-meta={"fingerprint":"549d8180e5abda09a81f193105838ccca5262c562e947f1223176572878437df","multiline":false,"placeholders":[]}
#: src/chrys/foundation/errors/display.py
msgid "error.kind.context_overflow"
msgstr "请求超出了模型的上下文窗口。请确认模型配置中的上下文窗口与模型实际一致。"

#. English: The model profile's maximum context window
#. ({configured_max_context_tokens}) is larger than the server's limit
#. ({server_max_context_tokens}). Set "Max Context Window" in the model profile
