#. English: Session In Use
#. chrys-meta={"fingerprint":"237cc6d792bf33e263a0532716afba37c9c73f30f36cc6936a08e358195d896e","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/main/event_handlers.py
