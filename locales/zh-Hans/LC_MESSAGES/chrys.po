#. English: Used by agents whose profile sets no mode; off turns web fetch off
#. for them.
#. chrys-meta={"fingerprint":"9f96b367f593731e6871bf2355df95fb9e65d5efc030a72a99f0f5dd2a93a769","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/settings/layout.py
