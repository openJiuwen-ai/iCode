"当前模型配置不支持图像输入。\n"
"\n"
"请在“模型”中启用“视觉模型”，或切换到多模态配置后重新发送消息。\n"
"\n"
"未附加的图像：\n"
"{files}"

#. English: This model's provider runs web search, so the local {tools} tool(s)
#. were disabled for this run. Provider-run search is not covered by iCode
#. approval rules or network grants. Remove the hosted web tool declaration
#. from the model's chat options to use local tools instead.
#. chrys-meta={"fingerprint":"ccf4dce41e029f38bef7e380cc59fc6f9baeccae28ff830cc23cfc27d57a9e07","multiline":false,"placeholders":["tools"]}
#: src/chrys/service/tools/builtins/web/hosted.py
msgid "builder.hosted_web_tools_preferred"
msgstr "当前模型的提供方会自行运行网络搜索，因此本次运行已停用本地 {tools} 工具。由提供方运行的搜索不受 iCode 审批规则和网络授权约束。如需改用本地工具，请从该模型的 Chat 选项中删除托管网络工具声明。"

#. English: Auto-loaded memory truncated at the token cap. Loaded
#. {loaded_count} file(s); skipped {skipped_count}.
#. chrys-meta={"fingerprint":"ec2d730500cf2fc87e92ffad944ded8f9647bd91be86615f27a5fd2db9f5492e","multiline":false,"placeholders":["loaded_count","skipped_count"]}
#: src/chrys/service/context/memory_loader.py
msgid "builder.memory_truncated"
msgstr "自动加载的记忆内容已在词元上限处截断。已加载 {loaded_count} 个文件；跳过 {skipped_count} 个。"

#. English: Protected chat option key(s) were stripped: {keys}. These keys can
#. no longer be configured in profile YAML because they bypass context
#. admission. Reusable prompts and profile-pinned continuation IDs are
#. unavailable there; store: true only enables automatically managed Responses
#. continuation.
#. chrys-meta={"fingerprint":"54a3a12277627c009dd25019148e508e2dc8d02dccb25415e738ef31035fe248","multiline":false,"placeholders":["keys"]}
#: src/chrys/orchestration/engine/build/builder.py
msgid "builder.protected_chat_options_stripped"
msgstr "已移除受保护的 Chat 选项键：{keys}。这些键不能再在配置文件 YAML 中设置，因为它们会绕过上下文准入。该处不支持可复用提示词和配置文件固定的续接 ID；store: true 仅启用自动管理的 Responses 续接。"

#. English: Agent {agent} starts without its web tools: {reason}
#. chrys-meta={"fingerprint":"f46183a2ff19ece59e3ce3ca28c4b38e7d36a9ca513bff3f1ca3fbf018df26f8","multiline":false,"placeholders":["agent","reason"]}
#: src/chrys/service/tools/builtins/web/build.py
msgid "builder.web_tools_unavailable"
msgstr "智能体 {agent} 启动时未包含网络工具：{reason}"

#. English: Global hooks config could not be loaded: {detail}.  Global hooks
#. disabled.
#. chrys-meta={"fingerprint":"9197214b677cb1766796c06abe807430eeef5901d8ff94d643dd2b83e16ca9c7","multiline":true,"placeholders":["detail"]}
#: src/chrys/orchestration/session_hooks.py
msgid "construction.global_hooks_invalid"
msgstr "无法加载全局钩子配置：{detail}。已禁用全局钩子。"

#. English: Hook '{hook_id}' in {path} was skipped: {detail}. The other hooks
#. in this file still run.
#. chrys-meta={"fingerprint":"6c1b213cf96ec7699a2fe2c1db21bfad8e0ac0d17705553d1484138428ee9e4e","multiline":true,"placeholders":["detail","hook_id","path"]}
#: src/chrys/orchestration/session_hooks.py
msgid "construction.hook_skipped"
msgstr "已跳过 {path} 中的钩子“{hook_id}”：{detail}。该文件中的其他钩子仍会运行。"

#. English: Project hooks config could not be loaded: {detail}. Project hooks
#. disabled; global hooks unaffected.
#. chrys-meta={"fingerprint":"9839468e9ee83c7dc2f6f497db1b93d2ffe39523039e736b1af7248098a200f4","multiline":true,"placeholders":["detail"]}
#: src/chrys/orchestration/session_hooks.py
msgid "construction.project_hooks_invalid"
msgstr "无法加载项目钩子配置：{detail}。已禁用项目钩子；全局钩子不受影响。"

#. English: The previous OpenAI Responses service session is not compatible
#. with the active agent profile, workspace, model profile, service endpoint,
#. or storage is disabled. {app_name} will continue from local history only.
#. chrys-meta={"fingerprint":"4c9bb5f2338ec7bf27b1abf99e9510177a29a3a6dc2977721ab5ee61235cf1ca","multiline":false,"placeholders":["app_name"]}
#: src/chrys/orchestration/engine/loader.py
