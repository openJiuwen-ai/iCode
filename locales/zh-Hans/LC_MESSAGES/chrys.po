#. English: Agent started by default at the next launch.
#. chrys-meta={"fingerprint":"dbfa49ffded7d732950a73ebbecf4b1373f7b62483bc2e410f4795c95ab43b02","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/settings/layout.py
msgid "tui.settings.hint.agent.default_profile"
msgstr "下次启动时默认使用的智能体。"

#. English: Once a day at startup, look up the newest version and show it on
#. the welcome screen. Sends no personal data.
#. chrys-meta={"fingerprint":"4664a03299f05cf4eba84a768e8af328d4ac74381e485614890aa575faa295ce","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/settings/layout.py
msgid "tui.settings.hint.app.update_check"
msgstr "每天启动时最多查询一次最新版本，并显示在欢迎页上。不会发送任何个人数据。"

#. English: Approval mode at the next launch; /approval changes both the
#. current session and this default. /approval bypass applies to the current
#. launch only and saves auto.
#. chrys-meta={"fingerprint":"3ef1c3ca6c4970c15e2fd564c9f4d92a04e52329f560cedba67db55c92ba2d87","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/settings/layout.py
msgid "tui.settings.hint.approval.default_mode"
msgstr "下次启动时的审批模式；/approval 会同时更改当前会话和此默认值。/approval bypass 仅作用于本次启动，并保存为 auto。"

#. English: In auto mode, calls the approval judge approves run without a
#. dialog; the dialog opens only when a call is flagged or cannot be evaluated.
#. Turn this off to see each call while it is evaluated and decide first.
#. chrys-meta={"fingerprint":"533cc7559a60a7eeef7199a6f6f54fa72a7000501081bb92e42efef54dbd033c","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/settings/layout.py
msgid "tui.settings.hint.approval.defer_while_judging"
msgstr "自动模式下，自动审查批准的调用直接运行，不弹对话框；只有调用被标记或无法评估时才弹出。关闭后，每个调用在评估期间就会显示，可以先行决定。"

#. English: Seconds to wait for human approval in TUI and ACP; timeout rejects
#. the call. Default 0 means no timeout. Restart to apply.
#. chrys-meta={"fingerprint":"2832be4bf24136d03294cd2ba97b7b7f272434f8a94d710fae5522b3fd91a49e","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/settings/layout.py
msgid "tui.settings.hint.approval.timeout_seconds"
msgstr "TUI 和 ACP 等待人工审批的秒数，超时后拒绝本次调用。默认 0 表示不超时，重启后生效。"

#. English: Remember what you type so you can bring it back later with Ctrl+R.
#. chrys-meta={"fingerprint":"5f63c61f7c1984a99d21d4bdc5ca7f6576efe3b8d5f814995cb362565c606618","multiline":false,"placeholders":[]}
