msgstr "另请参阅"

#. English: SYNOPSIS
#. chrys-meta={"fingerprint":"b5e157a7a8ceda0c9412146d37af30eadcc4e96dd43afec5004e1528edf53c4e","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.heading.synopsis"
msgstr "用法"

#. English: {app} is a terminal-based AI assistant for code exploration,
#. analysis, and understanding.
#. chrys-meta={"fingerprint":"1124778f7a8fd26b84b8aa8fe93fe95016bed58307806686f2af3d4021fe9088","multiline":true,"placeholders":["app"]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.index.description"
msgstr ""
"{app} 是一款用于代码探索、\n"
"分析和理解的终端 AI 助手。"

#. English: {app} - AI-powered code assistant
#. chrys-meta={"fingerprint":"a285e3786bff8436b3d0124a6144812b65109cb7d0c4b7bd70519367f6da9d09","multiline":false,"placeholders":["app"]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.index.name"
msgstr "{app} - AI 驱动的代码助手"

#. English: Show detailed help for a specific command
#. chrys-meta={"fingerprint":"c74196aa0f4a1b11ae75f06481cfc2e64b93d0c4738e44d3542f869b9d6bb37c","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.index.see_also"
msgstr "显示指定命令的详细帮助"

#. English: Change the display language of the {app} interface.  Without
#. arguments, opens the language picker dialog. With a supported locale,
#. directly confirms that language.  Available locales can be listed using tab
#. completion after /language.
#. chrys-meta={"fingerprint":"3f7c56ae96e99b1a79a79fe00abb65869ff28f5086d1820586b4e6603a78b972","multiline":true,"placeholders":["app"]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.language.body"
msgstr ""
"更改 {app} 界面的显示语言。\n"
"\n"
"不带参数时，打开语言选择对话框。\n"
"指定支持的区域设置时，直接确认该语言。\n"
"\n"
"在 /language 后使用 Tab 补全可列出可用区域设置。"

#. English: Display detailed documentation for {app} commands.      Without
#. arguments, shows a list of all available commands.     With a command name,
#. shows detailed help for that command.
#. chrys-meta={"fingerprint":"dba128be44e62b57f1f0733559e667c85f0b8371a0e5dd40874592537aaf02fa","multiline":true,"placeholders":["app"]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.man.body"
msgstr ""
"显示 {app} 命令的详细文档。\n"
"\n"
"    不带参数时，显示所有可用命令。\n"
"    指定命令名称时，显示该命令的详细帮助。"

#. English: Open the model configuration dialog.  Configure:     - Model
#. provider (OpenAI, Anthropic, local, etc.)     - Model name and version     -
#. Temperature and other generation parameters     - API keys and endpoints
#. chrys-meta={"fingerprint":"28b09311e8ec1ff4993a34ff86aa6582fc78fa2de0d5dcdd432d23d97327a108","multiline":true,"placeholders":[]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.models.body"
msgstr ""
"打开模型配置对话框。\n"
"\n"
"配置：\n"
"    - 模型提供商（OpenAI、Anthropic、本地模型等）\n"
"    - 模型名称和版本\n"
"    - 温度及其他生成参数\n"
"    - API 密钥和端点"

#. English: Start a completely new {app} session.  This clears the current
#. conversation context and begins fresh. Use this when you want to work on a
#. new task without carrying over previous context.
#. chrys-meta={"fingerprint":"bd9205a64c33761fa0b4d5d4aad52bc492da73d97d3d23e102c9055f24bebc99","multiline":true,"placeholders":["app"]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.new.body"
msgstr ""
"开始一个全新的 {app} 会话。\n"
"\n"
"这会清除当前对话上下文并重新开始。\n"
"当你想处理新任务且不希望沿用先前上下文时，可使用此命令。"

#. English: Copy agent turns. /copy N is shorthand for /copy agent N.
#. chrys-meta={"fingerprint":"fc0f4965af64632971a8327c96a55b851b4c1e4a7c3e3bcea65a23440ec5fd03","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.option.copy_agent"
msgstr "复制智能体轮次。/copy N 是 /copy agent N 的简写。"

#. English: Copy the full conversation transcript.
#. chrys-meta={"fingerprint":"f1ec1da9e657535cda69e9a785c41c34555bde47f261afb6f26a02b25c01f70c","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.option.copy_all"
msgstr "复制完整对话记录。"

#. English: Positive integer count of recent turns to copy.
#. chrys-meta={"fingerprint":"570e371a8f7b1bb5be7a923fd414e567d735aff3c95216b2b053fa4211f5b5e1","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.option.copy_count"
msgstr "要复制的最近轮次数，必须为正整数。"

#. English: Copy user turns.
#. chrys-meta={"fingerprint":"80738e9cb2f120e00407bbbf6ee79eaa00b7d0ee06fa7f2534cc26b03c08310a","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.option.copy_user"
msgstr "复制用户轮次。"

#. English: Positive number of most recent turns to discard.
#. chrys-meta={"fingerprint":"7c58c6c8cda6bbf485cee3201186bef7e3724827376ea79ac5c145b8ad414b86","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.option.rollback_count"
msgstr "要丢弃的最近轮次数，必须为正数。"

#. English: Keep turns 1 through N and discard every later turn. N may be 0.
#. chrys-meta={"fingerprint":"133dff90fe795ee2d87a88a6b1a1cadfad5f4f33c2f138c70718c1e15a17f6ff","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.option.rollback_target"
msgstr "保留第 1 至第 N 轮，并丢弃之后的所有轮次。N 可以为 0。"

#. English: This command does not take additional options.
#. chrys-meta={"fingerprint":"dcabecbb61b813204aed5a5ff4517505bdb41c013211f28cb529dd089d6772ca","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.options.no_additional_options"
msgstr "此命令不接受其他选项。"

#. English: This command supports subcommands.
#. chrys-meta={"fingerprint":"2cecc4eb179b3292b859eac4d9c06b800f990662fffa8af193ba404b8b608fd1","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.options.supports_subcommands"
msgstr "此命令支持子命令。"

#. English: With a title argument, apply it directly as the custom session
#. title. Without one (or with only whitespace), open the session title editor
#. — the same dialog as clicking the session title on the chat border.  A
#. custom title becomes the permanent title for this session (chat border,
#. terminal tab, session list) and disables auto-generated titles. Clearing it
#. in the editor falls back to the automatic title.
#. chrys-meta={"fingerprint":"3c7dc42eeef2c87987eeeea4aebc7a9508cf627e7723ab123430bacdb13e0d96","multiline":true,"placeholders":[]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.rename.body"
msgstr ""
"指定标题参数时，直接将其设为自定义会话标题。\n"
"未指定参数（或仅包含空白）时，打开会话标题编辑器——\n"
"也就是点击聊天边框上的会话标题时出现的对话框。\n"
"\n"
"自定义标题会成为此会话的永久标题，并显示在聊天边框、\n"
"终端标签页和会话列表中，同时停用自动生成标题。\n"
"在编辑器中清除自定义标题后，将恢复使用自动标题。"

#. English: Resume the most recent {app} chat conversation.
#. chrys-meta={"fingerprint":"a03825b57535dc2aefc7abb3ca2cff7432c9933163dc3273f49cc5a9fe47108e","multiline":true,"placeholders":["app"]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.resume.body"
msgstr "恢复最近的 {app} 聊天对话。"

#. English: Roll back recent conversation turns.  Without arguments, opens the
#. rollback picker at the most recent available target. Use this picker when
#. you want to discard conversation without restoring file changes.  A bare
#. number is a relative count. "/rollback 1" discards the last turn; "/rollback
#. 3" discards the last three turns. A valid explicit count executes
#. immediately.  The "to" form is an absolute target. "/rollback to 1" keeps
#. Turn 1 and discards Turns 2 through the current turn. Use "/rollback to 0"
#. to return to the session start. A valid explicit target executes
#. immediately.  Both explicit forms restore eligible file changes by default.
#. The picker also selects file rollback by default; explicitly turn it off
#. there to discard conversation only.  Explicit commands immediately show a
#. non-dismissible loading modal. Picker actions show it after confirmation. It
#. blocks interaction until rollback has completely finished.  Use with
#. caution: this action cannot be undone.
#. chrys-meta={"fingerprint":"21d96faba3950d2c6c5b91d3aacca2dba2efe0c6f3e5c1af343bb5037c654d88","multiline":true,"placeholders":[]}
#: src/chrys/app/tui/screens/main/commands.py
msgid "tui.man.rollback.body"
msgstr ""
"回滚最近的对话轮次。\n"
"\n"
"不带参数时，在最近可用目标处打开回滚选择器。若要丢弃对话\n"
"但不恢复文件更改，请使用此选择器。\n"
"\n"
"单独的数字表示相对数量。\"/rollback 1\" 会丢弃最后一轮；\n"
"\"/rollback 3\" 会丢弃最后三轮。有效的显式数量会立即执行。\n"
"\n"
"\"to\" 形式表示绝对目标。\"/rollback to 1\" 会保留第 1 轮，\n"
"并丢弃第 2 轮到当前轮次。使用 \"/rollback to 0\" 可返回会话\n"
"起点。有效的显式目标会立即执行。\n"
"\n"
"两种显式形式默认都会恢复符合条件的文件更改。选择器也默认\n"
"选择文件回滚；可在其中明确关闭此选项，仅丢弃对话。\n"
"\n"
"显式命令会立即显示无法关闭的加载对话框。选择器操作会在确认后\n"
"显示该对话框，并阻止交互，直到回滚完全结束。\n"
"\n"
"请谨慎使用：此操作无法撤销。"

#. English: Open the active runtime details dialog.      Shows:         - The
