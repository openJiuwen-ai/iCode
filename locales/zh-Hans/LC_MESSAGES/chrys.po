msgstr "名称"

#. English: OPTIONS
#. chrys-meta={"fingerprint":"f6765dc5133e549cbcc5d495378f4027bf742a9de4ac73ae41925c182d040454","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/main/commands.py
