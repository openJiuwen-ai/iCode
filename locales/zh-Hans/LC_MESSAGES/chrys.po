#. English: Results per search when the agent does not ask for a number;
#. default {default}.
#. chrys-meta={"fingerprint":"ded72010647583e59d376b27e16d140abb7dc0b38fa90744d4d6d938b0c9d28f","multiline":false,"placeholders":["default"]}
#: src/chrys/app/tui/screens/settings/layout.py
