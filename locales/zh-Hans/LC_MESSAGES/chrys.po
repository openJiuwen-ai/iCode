msgid "tui.settings.hint.history.prompt.enabled"
msgstr "记住你输入过的内容，之后可用 Ctrl+R 找回。"

#. English: Blank = the frontend default ({default}); 0 = never retry; at most
#. {maximum}.
#. chrys-meta={"fingerprint":"6a8589bec0a732e09d05d785106f2926581a8d6e85896d9cfd17d9b340fe7216","multiline":false,"placeholders":["default","maximum"]}
#: src/chrys/app/tui/screens/settings/layout.py
msgid "tui.settings.hint.llm.retry.max_transient"
msgstr "留空 = 前端默认值（{default}）；0 = 从不重试；最多 {maximum}。"

#. English: Writes API keys and full prompts in clear text to
#. <session>/llm_raw_http.jsonl.
#. chrys-meta={"fingerprint":"3fe4a2c7f98b5b8ec67cb1cd48adc9b95a72ece496f92f7de783f5802fa35616","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/settings/layout.py
msgid "tui.settings.hint.log.raw_http_capture"
msgstr "将 API 密钥和完整提示词以明文写入 <session>/llm_raw_http.jsonl。"

#. English: Model that judges tool approvals in auto mode.
#. chrys-meta={"fingerprint":"0aed872b52f4930ab2a4b8e8b87e66cb9a4316af94931942784af1fbe4e3d77e","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/settings/layout.py
msgid "tui.settings.hint.model.role.approval_judge"
