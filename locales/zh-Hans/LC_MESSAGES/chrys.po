msgstr "记录智能体行为的追踪与日志。"

#. English: Send telemetry to a collector, e.g. http://localhost:4317. Blank =
#. keep it in the session folder.
#. chrys-meta={"fingerprint":"b3e03e1fa612ce846b6a241b2ccef0f9814473ac8daf3029f844d2585f0a2571","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/settings/layout.py
msgid "tui.settings.hint.otel.endpoint"
msgstr "把遥测数据发送到收集器，例如 http://localhost:4317。留空 = 保存在会话文件夹中。"

#. English: Include prompts and tool payloads in telemetry.
#. chrys-meta={"fingerprint":"9e12ee0be20e37882c8e09132a41ee3abcd6ad2cb62453f696d44ffe24a9ed8c","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/settings/layout.py
msgid "tui.settings.hint.otel.sensitive_data"
msgstr "在遥测数据中包含提示词和工具载荷。"

#. English: Project settings found ({count} key) — enable to apply them.
#. English-plural: Project settings found ({count} keys) — enable to apply
#. them.
#. chrys-meta={"fingerprint":"ce357c8c3e53500591c67a1f3e8d3e3c2d6fd014c289b2d3040beceee4f2b5fb","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/settings/layout.py
msgid "tui.settings.hint.project.config_dormant"
msgid_plural "tui.settings.hint.project.config_dormant#plural"
msgstr[0] "发现项目设置（{count} 个键）— 启用后生效。"

#. English: Let <workspace>/.chrys/settings.yaml adjust engineering settings
#. for that workspace.
#. chrys-meta={"fingerprint":"9884d643e237794ad469fe31e654f3e0a1a3aa63ad7371536da2a4d099797284","multiline":false,"placeholders":[]}
#: src/chrys/app/tui/screens/settings/layout.py
msgid "tui.settings.hint.project.config_enabled"
