/* The docked editor and its dialogs share the application's flat controls. */

/* Compact per-row action, matching ConfigCard's transparent red icon. */
_ResetButton {
    height: 1;
    border: none;
    background: transparent;
    color: $error;
    text-style: bold;

    &:hover {
        background: $foreground 8%;
    }
    &:focus {
        background: $foreground 12%;
        text-style: $button-focus-text-style;
    }
    &.-active {
        background: $foreground 12%;
    }

    /* The dirty-state system toggles this class on each per-row reset
       button: clean rows hide their ``↺`` glyph entirely so the reset
       becomes its own dirty indicator.  ``visibility: hidden`` keeps
       the reset column's slot so rows stay aligned. */
    &.--clean {
        visibility: hidden;
    }
}

/* Shared one-row color swatch without Button's default tall edges. */
_ColorSwatchButton {
    height: 1;
    color: auto;
    border-top: none;
    border-bottom: none;

    &:focus {
        text-style: bold;
        text-opacity: 100%;
    }

    /* ``(not set)`` and non-hex values (``transparent``, ``ansi_X N%``)
       share styling — explicit transparent background so we don't fall
       through to ``Button``'s default ``$boost`` (which textual rewrites
       to opaque on themes without ``panel`` set). */
    &.--unset, &.--non-hex {
        background: transparent;
        color: $foreground 50%;
        text-style: italic;

        /* The transparent background hides the default Button focus
           indicator (a tint with nothing to tint).  Paint a translucent
           primary on focus + restore foreground brightness so keyboard
           users can see which row they're on. */
        &:focus {
            background: $primary 30%;
            color: $foreground;
        }
    }

    &:hover {
        tint: $background 25%;
    }
    &.-active {
        tint: $background 50%;
    }
}

/* Generic color-picker modal for named colors and variables. */
_PickerModal {
    align: center middle;

    & > VerticalGroup {
        width: 90;
        max-width: 95%;
        height: 36;
        max-height: 90%;
        padding: 0 1;
        background: $surface;
        border: round $tui-border-primary $border-opacity;
        border-title-color: $primary;
        border-title-style: bold;
    }
    #picker-body { height: 1fr; overflow-x: auto; scrollbar-size: 1 1; }
    #picker-body > Label { width: 1fr; }
    #picker-host { height: auto; padding: 1 0 0 0; }
    #picker-actions { height: 3; padding: 0; align: right middle; }
    #picker-actions Button { width: auto; min-width: 12; margin: 0 0 0 1; }
    #picker-error { height: auto; min-height: 1; color: $error; }
    #css-value { margin-top: 1; }
    &.--raw > VerticalGroup { width: 76; height: 12; }
    &.--raw #picker-body { padding-top: 1; }
    &.--ansi > VerticalGroup { width: 52; height: 26; }
    &.--xterm > VerticalGroup { height: 32; }
    &.--xterm #picker-host { min-width: 73; }
    &.--rgb.--opaque > VerticalGroup { height: 32; }
}

/* Match the single-line fields in BasicConfigPanel and SubAgentCard. */
_PickerModal #css-value,
SaveThemeDialog #theme-name {
    height: 1;
    border: none;
    background: $foreground 8%;
    padding: 0 1;
}

_PickerModal #css-value:focus,
SaveThemeDialog #theme-name:focus {
    border: none;
    background: $foreground 12%;
}

/* Panel-level ANSI fields use the same lifted shades as config panels. */
App:ansi _PickerModal #css-value,
App:ansi SaveThemeDialog #theme-name {
    background: $control-background-muted;
}

App:ansi _PickerModal #css-value:focus,
App:ansi SaveThemeDialog #theme-name:focus {
    background: $control-background;
}

_AnsiTokenPicker {
    width: 30;
    height: 17;
}

_Xterm256PalettePicker {
    width: 73;
    /* Reserve the longest layout, including the opaque-only hint.
       Shorter layouts pad trailing rows in ``render_line``. */
    height: 23;

    /* Match the compact checkboxes in Settings. */
    .palette--transparent,
    .palette--transparent-selected {
        color: $foreground 35%;
        background: $foreground 6%;
    }
    .palette--transparent-selected {
        color: $success;
    }
}

/* Fixed document controls above the independently scrolling color fields. */
ResettableThemeEditor {
    height: 100%;
    width: 100%;
    min-width: 0;
    padding: 1 0 0 1;
    border-right: none;

    #theme-editor-body {
        height: 1fr;
        border: round $tui-border-primary $border-opacity;
        border-title-color: $primary;
    }
    #theme-document-controls {
        height: 3;
        margin: 0 1;
        align: left middle;
    }
    #theme-select { width: 1fr; height: 1; }
    SelectCurrent {
        height: 1;
        border: none;
        background: $foreground 8%;
        padding: 0 1;
    }
    Select:focus SelectCurrent { background: $foreground 12%; }
    SelectOverlay {
        height: auto;
        max-height: 12;
        border: round $tui-border-primary $border-opacity;
        background: $surface;
    }
    #base-theme {
        width: 1fr;
        height: auto;
        padding: 0 1;
        text-align: center;
        color: $foreground 60%;
    }
    #theme-fields {
        width: 100%;
        height: 1fr;
        border: none;
        scrollbar-size: 1 1;
        scrollbar-color: $scrollbar;
        scrollbar-color-hover: $scrollbar-hover;
        scrollbar-color-active: $scrollbar-active;

        & > .--group-header {
            width: 1fr;
            padding: 1 0 0 1;
            text-align: left;
            text-style: none;
            color: $primary;
        }
        & > VerticalGroup.--rows-grid {
            layout: grid;
            grid-size: 3;
            grid-columns: 1fr 11 1;
            grid-rows: auto;
            grid-gutter: 1;
            height: auto;
            padding: 1;
            & > Button { min-width: 11; width: 11; }
            & > Label {
                width: 1fr;
                height: auto;
                padding: 0;
                text-align: left;
                text-style: bold;
                content-align: left middle;
            }
            & > Button.--reset-color {
                text-style: bold;
                min-width: 1;
                width: 1;
                padding: 0;
                content-align: center middle;
            }
        }
    }
    #editor-error { display: none; height: auto; max-height: 3; color: $error; }
    & > HorizontalGroup { height: 3; padding: 0 1 0 0; }
    & > HorizontalGroup Button { width: 1fr; min-width: 8; margin: 0; }
    & > .theme-actions Button:first-child { margin-right: 1; }
    #theme-delete { margin-right: 1; }
}

ThemeEditorPanel {
    split: left;
    height: 100%;
    width: 38%;
    min-width: 34;
    max-width: 42;
    background: $surface;
    border-right: none;
}

/* Preserve a useful chat preview when three columns cannot fit. */
MainScreen.--theme-editor-compact ChatPanel { min-width: 0; }
MainScreen.--theme-editor-compact ChatColumn { min-width: 0; }

SaveThemeDialog {
    align: center middle;
    #save-theme-container {
        width: 64;
        max-width: 95%;
        height: auto;
        max-height: 90%;
        padding: 1 2 0 2;
        border: round $tui-border-primary $border-opacity;
        border-title-color: $tui-border-title-primary;
        background: $surface;
    }
    Label { width: 1fr; height: auto; }
    #theme-name { margin-bottom: 1; }
    #save-theme-hint { color: $text-muted; margin-bottom: 1; }
    #save-theme-error { color: $warning; min-height: 1; max-height: 5; }
    #save-theme-error.--error { color: $error; }
    DialogButtonRow { dock: none; height: 3; margin-top: 1; padding: 0; align-horizontal: right; }
    DialogButtonRow Button { min-width: 10; margin: 0 0 0 1; }
}
