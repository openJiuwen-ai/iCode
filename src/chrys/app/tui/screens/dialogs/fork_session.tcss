ForkSessionDialog {
    align: center middle;
}

#fork-session-container {
    width: 58;
    max-width: 100%;
    max-height: 100%;
    overflow-y: auto;
    height: auto;
    min-height: 8;
    border: round $tui-border-warning $border-opacity;
    border-title-color: $warning;
    border-title-style: bold;
}

#fork-session-inner {
    width: 100%;
    height: auto;
    min-height: 6;
    background: $surface;
}

#fork-session-loading {
    width: 100%;
    height: 1;
    color: $warning;
    margin: 1 0 0 0;
}

#fork-session-message {
    width: 100%;
    height: auto;
    min-height: 1;
    content-align: center middle;
    text-align: center;
    margin: 1 0;
}

#fork-session-tab-reason, #fork-session-command {
    height: auto;
    padding: 0 1;
    text-align: center;
}

#fork-session-command {
    margin-bottom: 1;
    text-style: bold;
}

#fork-session-copy-row {
    align-horizontal: center;
    margin-bottom: 1;
}

#fork-session-copy {
    width: auto;
    min-width: 0;
    height: 1;
    padding: 0;
    color: $primary;
    background: transparent;
    text-style: bold;
    pointer: pointer;
}

#fork-session-copy:hover {
    background: $foreground 15%;
}

#fork-session-copy:focus {
    text-style: bold underline;
}

ForkSessionDialog DialogButtonRow {
    dock: none;
}

ForkSessionDialog DialogButtonRow > Button {
    min-width: 6;
    margin: 0 1;
}

ForkSessionDialog.-success #fork-session-container {
    border: round $tui-border-primary $border-opacity;
    border-title-color: $primary;
}

ForkSessionDialog.-success #fork-session-loading {
    color: $success;
}

ForkSessionDialog.-error #fork-session-container {
    border: round $tui-border-error $border-opacity;
    border-title-color: $error;
}

ForkSessionDialog.-error #fork-session-loading {
    color: $error;
}
